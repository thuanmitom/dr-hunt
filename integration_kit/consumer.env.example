# Reference consumer settings. Copy to consumer.env, fill in, keep it out of version control.

# --- HuntCompiler (values from the HuntCompiler operator) ---
# https:// everywhere; http:// is accepted only for localhost or 127.0.0.1 when HuntCompiler runs on this machine
HC_KIT_BASE_URL=https://huntcompiler.example
HC_KIT_TENANT=tencongty
HC_KIT_API_TOKEN=
HC_KIT_HMAC_SECRET=
# HuntCompiler in a LAN with HC_TLS_MODE=internal: Caddy's root certificate (docs/INSTALL.md in HuntCompiler)
# HC_KIT_CA_BUNDLE=/etc/ssl/huntcompiler-ca.pem
# HC_KIT_ALLOW_HTTP=true          # lab only

# --- Local state and your own data ---
HC_KIT_STATE_DIR=./hc-kit-state
HC_KIT_TELEMETRY=sysmon:1,sysmon:3,sysmon:6,sysmon:7,sysmon:11,sysmon:13,sysmon:22,windows_security:4624,windows_security:4625,windows_system:7045
# JSON, e.g. {"EDGE_DEVICE_INTERNAL_IPS": ["10.0.0.1"], "DMZ_HOST_IPS": ["10.10.0.5"]}
HC_KIT_PLACEHOLDERS_FILE=./placeholders.json
# CSV with a header row: upn,sam,mail (to resolve exposed accounts)
HC_KIT_DIRECTORY_CSV=./directory.csv
HC_KIT_MAX_HITS=1000

# --- Platform: wazuh | elastic | splunk ---
HC_KIT_PLATFORM=wazuh

HC_KIT_WAZUH_URL=https://wazuh-indexer.internal:9200
HC_KIT_WAZUH_INDEX=wazuh-archives-*
HC_KIT_WAZUH_USER=hc-hunter
HC_KIT_WAZUH_PASSWORD=
HC_KIT_WAZUH_CA_BUNDLE=

HC_KIT_ELASTIC_URL=https://es.internal:9200
HC_KIT_ELASTIC_INDEX=logs-*
HC_KIT_ELASTIC_API_KEY=
HC_KIT_ELASTIC_LANGUAGE=eql
HC_KIT_ELASTIC_PIPELINE=ecs_windows
HC_KIT_ELASTIC_CA_BUNDLE=

HC_KIT_SPLUNK_URL=https://splunk.internal:8089
HC_KIT_SPLUNK_TOKEN=
HC_KIT_SPLUNK_INDEX=
HC_KIT_SPLUNK_SOURCE_STYLE=classic
HC_KIT_SPLUNK_CA_BUNDLE=
