# Copy to .env and fill in. Never commit .env.
HC_ENVIRONMENT=prod
HC_LOG_LEVEL=INFO
# text (default) or json: one JSON object per line, for a SIEM
HC_LOG_FORMAT=text

# URL-safe values only (they are embedded in connection URLs): openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Fernet key(s), comma-separated; first one encrypts, all decrypt (rotation):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HC_MASTER_ENCRYPTION_KEYS=

# --- External providers (used from Phase 2/3) ----------------------------------
HC_GEMINI_API_KEY=
HC_GEMINI_MODEL_FAST=gemini-2.5-flash
HC_GEMINI_MODEL_DEEP=gemini-2.5-pro
HC_URLSCAN_API_KEY=
HC_GITHUB_TOKEN=
HC_ABUSECH_AUTH_KEY=
HC_TELEGRAM_API_ID=
HC_TELEGRAM_API_HASH=

# --- Phase 2 collectors ------------------------------------------------------------
HC_CONTACT_EMAIL=
# The public endpoint below accepts connections but has sent no certificates (2026-11-05). Self-host instead:
#   docker compose --profile certstream up -d certstream-server, then HC_CERTSTREAM_URL=ws://certstream-server:8080/
HC_CERTSTREAM_URL=wss://certstream.calidog.io/
HC_COLLECTOR_INTERVAL_MINUTES=30
HC_KEV_LOOKBACK_DAYS=7
# Daily retry (04:15 UTC) of GitHub PoC/Nuclei data that a KEV entry missed; gives up after this many runs (D-71)
HC_KEV_REENRICH_MAX_ATTEMPTS=5
HC_EPSS_ALERT_THRESHOLD=0.10
# JSON list of known-bad JARM fingerprints (corroborating evidence only)
HC_SUSPICIOUS_JARM_FINGERPRINTS=[]

# --- Phase 2b: leak monitoring & reference datasets ---------------------------------
# One-time: python -m scripts.telegram_login  (dedicated research account)
HC_TELEGRAM_SESSION=
# Public channels only, read-only, never joined by invitation (D-73). Keep the list's reasons in an internal file.
HC_TELEGRAM_CHANNELS=[]
# HIBP: only for domains you own and have verified in the HIBP dashboard (D-73); list them in brand.email_domains
HC_HIBP_API_KEY=
HC_MALWAREBAZAAR_TAGS=["LummaStealer","StealC","RedLineStealer","Vidar"]
HC_REFERENCE_SYNC_HOURS=6
# OSV malicious packages: <base>/<ecosystem>/modified_id.csv + one JSON per advisory (not all.zip)
HC_OSV_BASE_URL=https://osv-vulnerabilities.storage.googleapis.com
HC_OSV_MAX_IDS_PER_RUN=1000

# --- Phase 3: AI compiler (off by default: packs then use deterministic templates only) ---
HC_LLM_ENABLED=false
HC_LLM_DAILY_TOKEN_BUDGET=2000000
HC_LLM_VECTORS=["edge_device_exploit","clickfix_fileless"]

# --- Phase T: Telegram digest + command bot (BotFather token; NOT the Telethon research account) ---
# First run: leave the two ID lists empty, start the bot, send /start, read chat_id and user_id from
# `docker compose logs telegram-bot`, fill them in, restart worker, beat and telegram-bot.
HC_TGBOT_ENABLED=false
HC_TGBOT_TOKEN=
# Exactly one destination: your private chat (positive id) or one SOC group (negative id, -100... for supergroups)
HC_TGBOT_CHAT_IDS=[]
HC_TGBOT_ALLOWED_USER_IDS=[]
# Tenant slugs shown in the digest and in every command; empty = all tenants
HC_TGBOT_TENANTS=[]
HC_TGBOT_DIGEST_TIMES=["08:00"]
HC_TGBOT_TIMEZONE=Asia/Ho_Chi_Minh
HC_TGBOT_DIGEST_TOP=10
HC_TGBOT_SEND_EMPTY_DIGEST=true
HC_TGBOT_ATTACH_JSON=false
# Ops alerts (off by default, D-65): a job failing N runs in a row, or stale; carries no intelligence
HC_TGBOT_OPS_ALERTS=false
HC_TGBOT_OPS_ALERT_AFTER_FAILURES=3
HC_TGBOT_OPS_ALERT_COOLDOWN_HOURS=6

# --- Phase H: tenant API limits, retention, deployment ---------------------------------
# Per tenant (pull + feedback); per client IP, failed authentications allowed per window before 429
HC_API_RATE_LIMIT_PER_MINUTE=60
HC_API_AUTH_FAILURES_PER_IP=20
HC_API_AUTH_FAILURE_WINDOW_SECONDS=600
# Days kept; 0 keeps forever. Events of a still-active cluster are always kept.
HC_RETENTION_RAW_EVENT_DAYS=90
HC_RETENTION_AI_COMPILATION_DAYS=180
# Profile `edge` (Caddy, HTTPS). HC_TLS_MODE=public: Let's Encrypt for the public DNS name of this host (ports 80/443
# reachable from the Internet). HC_TLS_MODE=internal: Caddy's local CA for a LAN; HC_PUBLIC_HOSTNAME is then the LAN
# name or IP consumers use, and they trust Caddy's root certificate (INSTALL.md).
HC_TLS_MODE=public
HC_PUBLIC_HOSTNAME=
# Internal Caddy -> API network (D-66); change only if this subnet clashes with another Docker network.
# Caddy's address must be inside the subnet and outside the dynamic range.
HC_EDGE_SUBNET=172.31.250.0/28
HC_EDGE_IP_RANGE=172.31.250.8/29
HC_EDGE_CADDY_IP=172.31.250.2
# Profile `backup`: number of daily dumps kept
HC_BACKUP_KEEP=14

# --- Per-tenant secrets, referenced by name from config/tenant_manifest.yaml ----
# openssl rand -base64 48 | tr -d '\n'
HC_TENANT_TENCONGTY_HMAC_SECRET=
HC_TENANT_TENCONGTY_API_TOKEN=
